{
    "name": "pl-copy-sql",
    "properties": {
        "activities": [
            {
                "name": "set-run-start",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "v_run_start",
                    "value": {
                        "value": "@formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')\n",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "lkp-sql-metadata",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "sp-audit-init",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderQuery": {
                            "value": "@concat('SELECT * FROM [dbo].[TableMetadata] WHERE SourceSchema = ''',pipeline().parameters.p_schema,''' AND SourceTable = ''',pipeline().parameters.p_table,'''')",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_server_aw22_onprem_home",
                        "type": "DatasetReference",
                        "parameters": {
                            "sqlTable": "TableMetadata",
                            "sqlSchema": "dbo",
                            "sqlDb": {
                                "value": "@variables('v_framework_db')",
                                "type": "Expression"
                            }
                        }
                    }
                }
            },
            {
                "name": "set-file-name",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "set-prev-watermark",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "v_file",
                    "value": {
                        "value": "@concat(pipeline().parameters.p_table,'-',replace(replace(variables('v_run_start'), ' ', '_'),':','-'),'.csv')\n\n\n",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "get-new-watermark",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "set-file-name",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderQuery": {
                            "value": "@concat('SELECT MAX(ModifiedDate) AS wm_new FROM ',pipeline().parameters.p_schema,'.',pipeline().parameters.p_table,' WHERE ModifiedDate > ''',activity('lkp-sql-metadata').output.firstRow.LastRunTimestamp, '''')",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_server_aw22_onprem_home",
                        "type": "DatasetReference",
                        "parameters": {
                            "sqlTable": {
                                "value": "@pipeline().parameters.p_table",
                                "type": "Expression"
                            },
                            "sqlSchema": {
                                "value": "@pipeline().parameters.p_schema",
                                "type": "Expression"
                            },
                            "sqlDb": "@pipeline().parameters.p_db"
                        }
                    }
                }
            },
            {
                "name": "if-new-data",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "get-new-watermark",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@not(equals(coalesce(activity('get-new-watermark').output.firstRow.wm_new, ''), ''))\n",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "copy-sql",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SqlServerSource",
                                    "sqlReaderQuery": {
                                        "value": "@concat('SELECT * FROM ',pipeline().parameters.p_schema,'.',pipeline().parameters.p_table,' WHERE ModifiedDate BETWEEN ''',variables('v_old_wm'),''' AND ''',activity('get-new-watermark').output.firstRow.wm_new, '''')",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "sink": {
                                    "type": "DelimitedTextSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextWriteSettings",
                                        "quoteAllText": true,
                                        "fileExtension": ".txt"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_sql_server_aw22_onprem_home",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "sqlTable": {
                                            "value": "@pipeline().parameters.p_table",
                                            "type": "Expression"
                                        },
                                        "sqlSchema": {
                                            "value": "@pipeline().parameters.p_schema",
                                            "type": "Expression"
                                        },
                                        "sqlDb": {
                                            "value": "@pipeline().parameters.p_db",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_as22",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "pContainer": "landing",
                                        "pFolder": {
                                            "value": "@pipeline().parameters.p_schema",
                                            "type": "Expression"
                                        },
                                        "pSubFolder": "@pipeline().parameters.p_table",
                                        "pFile": {
                                            "value": "@variables('v_file')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "update-watermark",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "set-copy-rowcount",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[dbo].[UpdateWatermark]",
                                "storedProcedureParameters": {
                                    "pLastRunTime": {
                                        "value": {
                                            "value": "@activity('get-new-watermark').output.firstRow.wm_new",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "pMetaId": {
                                        "value": {
                                            "value": "@activity('lkp-sql-metadata').output.firstRow.Id",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ln_SqlServer_AW22",
                                "type": "LinkedServiceReference",
                                "parameters": {
                                    "sqldb": {
                                        "value": "@variables('v_framework_db')",
                                        "type": "Expression"
                                    }
                                }
                            }
                        },
                        {
                            "name": "set-copy-duration",
                            "type": "SetVariable",
                            "dependsOn": [
                                {
                                    "activity": "copy-sql",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "v_copy_duration",
                                "value": {
                                    "value": "@activity('copy-sql').output.copyDuration",
                                    "type": "Expression"
                                }
                            }
                        },
                        {
                            "name": "set-copy-rowcount",
                            "type": "SetVariable",
                            "dependsOn": [
                                {
                                    "activity": "set-copy-duration",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "v_copy_rowcount",
                                "value": {
                                    "value": "@activity('copy-sql').output.rowsCopied",
                                    "type": "Expression"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "audit-success",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "if-new-data",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "storedProcedureName": "[dbo].[UpdateJobAuditDetail]",
                    "storedProcedureParameters": {
                        "pActivityName": {
                            "value": {
                                "value": "copy-sql",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pAuditId": {
                            "value": {
                                "value": "@activity('sp-audit-init').output.firstRow.oAuditId",
                                "type": "Expression"
                            },
                            "type": "Int32"
                        },
                        "pCopyDurationSeconds": {
                            "value": {
                                "value": "@variables('v_copy_duration')",
                                "type": "Expression"
                            },
                            "type": "Int32"
                        },
                        "pEndTime": {
                            "value": {
                                "value": "@utcNow()",
                                "type": "Expression"
                            },
                            "type": "DateTime"
                        },
                        "pErrorMessage": {
                            "value": null,
                            "type": "String"
                        },
                        "pRowsCopied": {
                            "value": {
                                "value": "@variables('v_copy_rowcount')",
                                "type": "Expression"
                            },
                            "type": "Int64"
                        },
                        "pStatus": {
                            "value": {
                                "value": "@variables('v_success_status')",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pSourceFilePath": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.SourceFilePath",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pSourceSystem": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.SourceSystem",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pTargetFilePath": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.TargetFilePath",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pTargetSystem": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.TargetSystem",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pTargetTable": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.TargetTable",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pMetadataId": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.Id",
                                "type": "Expression"
                            },
                            "type": "Int32"
                        },
                        "pWaterMarkPrevious": {
                            "value": {
                                "value": "@activity('lkp-sql-metadata').output.firstRow.LastRunTimestamp",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pWaterMarkCurrent": {
                            "value": {
                                "value": "@activity('get-new-watermark').output.firstRow.wm_new",
                                "type": "Expression"
                            },
                            "type": "String"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "ln_SqlServer_AW22",
                    "type": "LinkedServiceReference",
                    "parameters": {
                        "sqldb": "FrameworkDb"
                    }
                }
            },
            {
                "name": "sp-audit-init",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "set-run-start",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "dbo.InsertJobAuditDetail",
                        "storedProcedureParameters": {
                            "ActivityName": {
                                "type": "String",
                                "value": null
                            },
                            "CopyDurationSeconds": {
                                "type": "Int32",
                                "value": null
                            },
                            "EndTime": {
                                "type": "DateTime",
                                "value": null
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": null
                            },
                            "MetadataId": {
                                "type": "Int32",
                                "value": null
                            },
                            "PipelineName": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().Pipeline",
                                    "type": "Expression"
                                }
                            },
                            "RowsCopied": {
                                "type": "Int64",
                                "value": null
                            },
                            "RunId": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().RunId",
                                    "type": "Expression"
                                }
                            },
                            "SourceFilePath": {
                                "type": "String",
                                "value": null
                            },
                            "SourceSystem": {
                                "type": "String",
                                "value": null
                            },
                            "SourceTable": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().parameters.p_table",
                                    "type": "Expression"
                                }
                            },
                            "StartTime": {
                                "type": "DateTime",
                                "value": {
                                    "value": "@variables('v_run_start')",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": {
                                    "value": "@variables('v_init_status')",
                                    "type": "Expression"
                                }
                            },
                            "TargetFilePath": {
                                "type": "String",
                                "value": null
                            },
                            "TargetSystem": {
                                "type": "String",
                                "value": null
                            },
                            "TargetTable": {
                                "type": "String",
                                "value": null
                            },
                            "ParentAuditId": {
                                "type": "Int32",
                                "value": {
                                    "value": "@pipeline().parameters.p_audit_id_parent",
                                    "type": "Expression"
                                }
                            },
                            "WaterMarkPrevious": {
                                "type": "String",
                                "value": null
                            },
                            "WaterMarkCurrent": {
                                "type": "String",
                                "value": null
                            }
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_server_aw22_onprem_home",
                        "type": "DatasetReference",
                        "parameters": {
                            "sqlTable": "dummy",
                            "sqlSchema": "dummy",
                            "sqlDb": "@variables('v_framework_db')"
                        }
                    }
                }
            },
            {
                "name": "set-prev-watermark",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "lkp-sql-metadata",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "v_old_wm",
                    "value": {
                        "value": "@if(equals(trim(coalesce(activity('lkp-sql-metadata').output.firstRow.LastRunTimestamp,'')),''),'1900-01-01',activity('lkp-sql-metadata').output.firstRow.LastRunTimestamp)",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "p_db": {
                "type": "string",
                "defaultValue": "AdventureWorks2022"
            },
            "p_schema": {
                "type": "string",
                "defaultValue": "Sales"
            },
            "p_table": {
                "type": "string",
                "defaultValue": "ShoppingCartItem"
            },
            "p_audit_id_parent": {
                "type": "int",
                "defaultValue": 0
            }
        },
        "variables": {
            "v_run_start": {
                "type": "String"
            },
            "v_framework_db": {
                "type": "String",
                "defaultValue": "FrameworkDb"
            },
            "v_framework_table": {
                "type": "String",
                "defaultValue": "dbo.TableMetadata"
            },
            "v_file": {
                "type": "String"
            },
            "v_metadata_id": {
                "type": "Integer"
            },
            "v_init_status": {
                "type": "String",
                "defaultValue": "Started"
            },
            "v_audit_id": {
                "type": "Integer"
            },
            "v_old_wm": {
                "type": "String"
            },
            "v_success_status": {
                "type": "String",
                "defaultValue": "Succeeded"
            },
            "v_new_wm": {
                "type": "String"
            },
            "v_copy_duration": {
                "type": "Integer"
            },
            "v_copy_rowcount": {
                "type": "Integer"
            }
        },
        "annotations": [],
        "lastPublishTime": "2025-10-11T14:37:50Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}