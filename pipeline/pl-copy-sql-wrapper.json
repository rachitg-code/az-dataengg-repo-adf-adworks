								"variableName": "v_cd",
								"value": {
									"value": "@add(variables('v_copy_duration'),int(coalesce(activity('copy-a-table').output.pipelineReturnValue?.o_copy_duration,0)))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "set-added-copy-duration",
							"type": "SetVariable",
							"dependsOn": [
