						"activity": "init-audit-meta-wrapper",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('init-audit-meta-wrapper').output.pipelineReturnValue.oMetadata\n",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy-a-table",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl-copy-sql",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_db": {
										"value": "@json(item()).SourceContainer",
										"type": "Expression"
									},
									"p_schema": {
										"value": "@json(item()).SourceSchema",
										"type": "Expression"
									},
									"p_table": {
