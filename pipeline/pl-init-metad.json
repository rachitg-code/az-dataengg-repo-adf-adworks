								"type": "String",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							"RowsCopied": {
								"type": "Int64",
								"value": null
							},
							"RunId": {
								"type": "String",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"SourceContainer": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.p_source_container",
									"type": "Expression"
								}
							},
							"SourceFilePath": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.p_source_system",
									"type": "Expression"
								}
							},
							"SourceSchema": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.p_schema",
									"type": "Expression"
								}
							},
							"SourceSystem": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.p_source_system",
									"type": "Expression"
								}
							},
							"SourceTable": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.p_table",
									"type": "Expression"
								}
							},
							"StartTime": {
								"type": "DateTime",
								"value": {
									"value": "@variables('v_run_start')",
									"type": "Expression"
								}
							},
							"Status": {
								"type": "String",
								"value": {
									"value": "@variables('v_init_status')",
									"type": "Expression"
								}
							},
							"TargetFilePath": {
								"type": "String",
								"value": null
							},
							"TargetSystem": {
								"type": "String",
								"value": null
							},
							"TargetTable": {
								"type": "String",
								"value": null
							},
							"WaterMarkCurrent": {
								"type": "DateTime",
								"value": null
							},
							"WaterMarkPrevious": {
								"type": "DateTime",
								"value": null
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server_aw22_onprem_home",
						"type": "DatasetReference",
						"parameters": {
							"sqlTable": "dummy",
							"sqlSchema": "dummy",
							"sqlDb": "@variables('v_framework_db')"
						}
					}
				}
			},
			{
				"name": "set-error-lkp",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "lkp-sql-metadata",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl-error-log",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_activity_name": "lkp-sql-metadata",
						"p_audit_id": {
							"value": "@activity('sp-audit-init').output.firstRow.oAuditId",
							"type": "Expression"
