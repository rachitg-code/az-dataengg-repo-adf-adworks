{
	"name": "pl-init-metad",
	"properties": {
		"activities": [
			{
				"name": "set-run-start",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_run_start",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "lkp-sql-metadata",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "sp-audit-init",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM ', variables('v_framework_table'), '\nWHERE SourceSystem = ''',pipeline().parameters.p_source_system,''' AND SourceContainer = ''',pipeline().parameters.p_source_container,''' \nAND (SourceSystem NOT IN (''Database'') OR (SourceSchema = ''',pipeline().parameters.p_schema,'''\nAND SourceTable = ''',pipeline().parameters.p_table,'''))')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server_aw22_onprem_home",
						"type": "DatasetReference",
						"parameters": {
							"sqlTable": "TableMetadata",
							"sqlSchema": "dbo",
							"sqlDb": {
								"value": "@variables('v_framework_db')",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "sp-audit-init",
				"type": "Lookup",
